{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "RIAL",
  "description": "Prove a photo is real. Developer documentation for the RIAL API, CLI and native SDKs.",
  "colors": {
    "primary": "#1C1C1A",
    "light": "#5EDCF0",
    "dark": "#1C1C1A"
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "fonts": {
    "family": "Inter"
  },
  "styling": {
    "codeblocks": "dark",
    "eyebrows": "breadcrumbs"
  },
  "favicon": "/rial-isotype.svg",
  "logo": {
    "light": "/logo/rial-imagotype-light.svg",
    "dark": "/logo/rial-imagotype-dark.svg",
    "href": "https://www.rial.io"
  },
  "navigation": {
    "global": {
      "anchors": [
        { "anchor": "API reference", "icon": "code", "href": "https://docs.rial.io/api-reference" },
        { "anchor": "Dashboard", "icon": "gauge", "href": "https://app.rial.io" },
        { "anchor": "OpenAPI spec", "icon": "file-code", "href": "https://docs.rial.io/api-reference/openapi.json" },
        { "anchor": "MCP server", "icon": "plug", "href": "https://docs.rial.io/mcp-server" },
        { "anchor": "Agent skills", "icon": "robot", "href": "https://docs.rial.io/.well-known/agent-skills/rial/skill.md" },
        { "anchor": "Status", "icon": "signal", "href": "https://status.rial.io" }
      ]
    },
    "tabs": [
      {
        "tab": "Get started",
        "icon": "rocket",
        "groups": [
          {
            "group": "Start",
            "icon": "flag",
            "pages": ["index", "quickstart", "audits", "authentication"]
          },
          {
            "group": "Results",
            "icon": "badge-check",
            "pages": ["verdicts", "errors"]
          }
        ]
      },
      {
        "tab": "SDKs & tools",
        "icon": "code",
        "groups": [
          {
            "group": "Backend",
            "icon": "server",
            "pages": ["sdks/node", "cli", "mcp-server"]
          },
          {
            "group": "Mobile capture",
            "icon": "mobile",
            "pages": ["sdks/kotlin", "sdks/swift", "sdks/react-native"]
          },
          {
            "group": "Legal",
            "icon": "scale-balanced",
            "pages": ["legal/sdk-license"]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "book-open",
        "openapi": "api-reference/openapi.json"
      }
    ]
  },
  "navbar": {
    "links": [
      { "label": "Support", "icon": "message", "href": "mailto:ulises@rial.io" },
      { "label": "Dashboard", "href": "https://app.rial.io" }
    ],
    "primary": {
      "type": "button",
      "label": "Get an API key",
      "href": "https://app.rial.io/settings"
    }
  },
  "footer": {
    "links": [
      {
        "header": "RIAL",
        "items": [
          { "label": "rial.io", "href": "https://www.rial.io" },
          { "label": "Dashboard", "href": "https://app.rial.io" },
          { "label": "Status", "href": "https://status.rial.io" }
        ]
      }
    ]
  },
  "seo": {
    "metatags": {
      "og:title": "RIAL developer documentation",
      "og:description": "Prove a photo is real. API, CLI and native SDKs."
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "cursor", "vscode", "mcp"]
  }
}
