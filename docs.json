{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "rial",
  "description": "Prove a photo is real. Developer documentation for the rial API, CLI and native SDKs.",
  "colors": {
    "primary": "#EC1B8A",
    "light": "#EC1B8A",
    "dark": "#EC1B8A"
  },
  "appearance": {
    "default": "light"
  },
  "fonts": {
    "family": "Inter"
  },
  "styling": {
    "codeblocks": "system"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.rial.io"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start",
        "pages": ["index", "quickstart", "authentication"]
      },
      {
        "group": "Results",
        "pages": ["verdicts"]
      },
      {
        "group": "Tools",
        "pages": ["cli", "sdks/kotlin", "sdks/swift", "sdks/react-native"]
      },
      {
        "group": "API reference",
        "openapi": "api-reference/openapi.json"
      },
      {
        "group": "Legal",
        "pages": ["legal/sdk-license"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.rial.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get an API key",
      "href": "https://app.rial.io/settings"
    }
  },
  "footer": {
    "links": [
      {
        "header": "rial",
        "items": [
          { "label": "rial.io", "href": "https://www.rial.io" },
          { "label": "Dashboard", "href": "https://app.rial.io" },
          { "label": "Status", "href": "https://status.rial.io" }
        ]
      }
    ]
  },
  "seo": {
    "metatags": {
      "og:title": "rial developer documentation",
      "og:description": "Prove a photo is real. API, CLI and native SDKs."
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  }
}
