{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Rial",
  "description": "Verify that a photo is real. Developer documentation for the Rial API, CLI and native SDKs.",
  "colors": {
    "primary": "#1C1C1A",
    "light": "#5EDCF0",
    "dark": "#1C1C1A"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "Cormorant Garamond",
      "weight": 500
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "styling": {
    "codeblocks": "dark",
    "eyebrows": "breadcrumbs"
  },
  "favicon": "/rial-isotype.svg",
  "logo": {
    "light": "/logo/rial-imagotype-light.svg",
    "dark": "/logo/rial-imagotype-dark.svg",
    "href": "https://www.rial.io"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get started",
        "icon": "rocket",
        "groups": [
          {
            "group": "Start",
            "icon": "flag",
            "pages": [
              "index",
              "quickstart",
              "audits",
              "authentication"
            ]
          },
          {
            "group": "Results",
            "icon": "badge-check",
            "pages": [
              "verdicts",
              "errors"
            ]
          }
        ]
      },
      {
        "tab": "SDKs & tools",
        "icon": "code",
        "groups": [
          {
            "group": "Backend",
            "icon": "server",
            "pages": [
              "sdks/node",
              "cli",
              "mcp-server"
            ]
          },
          {
            "group": "Mobile capture",
            "icon": "mobile",
            "pages": [
              "sdks/kotlin",
              "sdks/swift",
              "sdks/react-native"
            ]
          },
          {
            "group": "Legal",
            "icon": "scale-balanced",
            "pages": [
              "legal/sdk-license"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "book-open",
        "openapi": "api-reference/openapi.json"
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "icon": "message",
        "href": "mailto:developers@rial.io"
      },
      {
        "label": "Dashboard",
        "href": "https://app.rial.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get an API key",
      "href": "https://app.rial.io/settings"
    }
  },
  "footer": {
    "links": [
      {
        "header": "RIAL",
        "items": [
          {
            "label": "rial.io",
            "href": "https://www.rial.io"
          },
          {
            "label": "Dashboard",
            "href": "https://app.rial.io"
          },
          {
            "label": "Status",
            "href": "https://status.rial.io"
          }
        ]
      }
    ]
  },
  "seo": {
    "metatags": {
      "og:title": "Rial developer documentation",
      "og:description": "Verify that a photo is real. API, CLI and native SDKs."
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode",
      "mcp"
    ]
  }
}
