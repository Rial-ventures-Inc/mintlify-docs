{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "rial",
  "description": "Verify that a photo is real, at the moment of capture. Developer documentation for the rial API, Kotlin SDK, and CLI.",
  "colors": {
    "primary": "#EC1B8A",
    "light": "#EC1B8A",
    "dark": "#EC1B8A"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://get-rial.com"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["index", "quickstart"]
      },
      {
        "group": "Core concepts",
        "pages": ["authentication", "verdicts"]
      },
      {
        "group": "SDKs",
        "pages": ["sdks/kotlin", "sdks/swift", "sdks/react-native"]
      },
      {
        "group": "CLI",
        "pages": ["cli"]
      },
      {
        "group": "API reference",
        "openapi": "api-reference/openapi.json"
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/Rial-ventures-Inc"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get an API key",
      "href": "https://get-rial.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Rial-ventures-Inc"
    },
    "links": [
      {
        "header": "rial",
        "items": [
          { "label": "get-rial.com", "href": "https://get-rial.com" },
          { "label": "Documentation", "href": "https://docs.get-rial.com" }
        ]
      }
    ]
  },
  "seo": {
    "metatags": {
      "og:title": "rial developer documentation",
      "og:description": "Verify that a photo is real, at the moment of capture. API reference, Kotlin SDK, and CLI docs for rial."
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  }
}
