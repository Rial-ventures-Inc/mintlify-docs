{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "RIAL",
  "description": "Prove a photo is real. Developer documentation for the RIAL API, CLI and native SDKs.",
  "colors": {
    "primary": "#1C1C1A",
    "light": "#5EDCF0",
    "dark": "#1C1C1A"
  },
  "appearance": {
    "default": "light"
  },
  "fonts": {
    "heading": {
      "family": "Cormorant Garamond",
      "weight": 500
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "styling": {
    "codeblocks": "system"
  },
  "favicon": "/rial-isotype.svg",
  "logo": {
    "light": "/logo/rial-imagotype-light.svg",
    "dark": "/logo/rial-imagotype-dark.svg",
    "href": "https://www.rial.io"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start",
        "pages": [
          "index",
          "quickstart",
          "authentication"
        ]
      },
      {
        "group": "Results",
        "pages": [
          "verdicts"
        ]
      },
      {
        "group": "Tools",
        "pages": [
          "cli",
          "sdks/kotlin",
          "sdks/swift",
          "sdks/react-native"
        ]
      },
      {
        "group": "API reference",
        "openapi": "api-reference/openapi.json"
      },
      {
        "group": "Legal",
        "pages": [
          "legal/sdk-license"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.rial.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get an API key",
      "href": "https://app.rial.io/settings"
    }
  },
  "footer": {
    "links": [
      {
        "header": "RIAL",
        "items": [
          {
            "label": "rial.io",
            "href": "https://www.rial.io"
          },
          {
            "label": "Dashboard",
            "href": "https://app.rial.io"
          },
          {
            "label": "Status",
            "href": "https://status.rial.io"
          }
        ]
      }
    ]
  },
  "seo": {
    "metatags": {
      "og:title": "RIAL developer documentation",
      "og:description": "Prove a photo is real. API, CLI and native SDKs."
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "background": {
    "color": {
      "light": "#FFFDF7",
      "dark": "#131312"
    }
  }
}
